SERVER_ADDRESS=localhost:9100
FRONTEND_DIR=dist
REQUEST_TIMEOUT=15s

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_INTERVAL=1s
RATE_LIMIT_BURST=40
RATE_LIMIT_MAX_CLIENTS=4096
RATE_LIMIT_IDLE_TTL=5m

RESOURCE_CACHE_TTL=1m
RESOURCE_CACHE_MAX_ENTRIES=1024
USERS_CACHE_MAX_ENTRIES=256

FILE_CACHE_TTL=1m
FILE_CACHE_MAX_ENTRIES=64
FILE_CACHE_MAX_BYTES=1048576

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_MAX_AGE=10m

# Setting a signing secret enables JWT authentication. Use at least 32 bytes.
JWT_SECRET=
JWT_ISSUER=go-api-kit-example
JWT_AUDIENCE=users-api
JWT_CONFIG_VERSION=v1
